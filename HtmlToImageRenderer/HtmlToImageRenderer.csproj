<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<RootNamespace>HtmlToImageRenderer</RootNamespace>
		<Description>Lightweight HTML5 + CSS renderer that rasterizes markup to PNG via SkiaSharp.</Description>
		<Platforms>AnyCPU;x64</Platforms>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Version>0.0.1</Version>
		<AssemblyVersion>0.0.1</AssemblyVersion>
		<FileVersion>0.0.1</FileVersion>
		<Authors>Zveruga</Authors>
		<PackageProjectUrl>https://github.com/Zverugakrt/HtmlToImageRenderer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Zverugakrt/HtmlToImageRenderer</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" Version="4.156.0" />
		<!-- Svg.Skia 5.2.3 targets net10.0 and depends on SkiaSharp >= 4.148.0, so the pinned 4.156.0 satisfies it. -->
		<PackageReference Include="Svg.Skia" Version="5.2.3" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
